<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#33445566" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#FCA311" />
            <stroke android:width="4dp" android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#E08E00" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#2E4A7D" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
